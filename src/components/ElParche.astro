---
const APP_URL = "https://app.lasociedaddelfermento.co";

const detalles = [
  { label: "Cuándo", valor: "Cada 15 días, los martes, 5:00 p.m." },
  {
    label: "Dónde",
    valor:
      "Somos itinerantes: cada encuentro cae en un lugar distinto de Medellín. La dirección exacta aparece en la app cuando reservas tu cupo.",
  },
  {
    label: "Cómo enterarte",
    valor:
      "Las invitaciones circulan por WhatsApp. Escríbenos por Instagram y te sumamos al grupo.",
  },
];
---

<section id="parche" class="parche">
  <div class="wrap parche-grid">
    <div>
      <p class="eyebrow">Qué es</p>
      <h2>El Parche<br />Fermentero</h2>
    </div>
    <div class="parche-body">
      <p>
        El Parche Fermentero es el encuentro quincenal de La Sociedad del
        Fermento: un espacio abierto para compartir procesos de
        fermentación, aprender unos de otros y probar lo que ha estado
        burbujeando en casa. No hace falta ser experto — solo tener ganas de
        fermentar algo (y de comerlo en buena compañía).
      </p>
      <dl class="detalles">
        {
          detalles.map((d) => (
            <div class="detalle">
              <dt class="meta">{d.label}</dt>
              <dd>{d.valor}</dd>
            </div>
          ))
        }
      </dl>
      <a href={APP_URL} class="btn">Quiero sumarme al próximo Parche</a>
    </div>
  </div>
</section>

<style>
  .parche {
    background: var(--color-bg-alt);
  }

  .parche-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.4fr;
    gap: var(--space-2xl);
  }

  .detalles {
    margin: var(--space-lg) 0;
    display: grid;
    gap: 1rem;
  }

  .detalle {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding: var(--space-sm) 0;
    border-top: 1px solid var(--color-line);
  }

  .detalle dt {
    font-size: 0.75rem;
  }

  .detalle dd {
    margin: 0;
  }

  @media (max-width: 800px) {
    .parche-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .detalle {
      grid-template-columns: 1fr;
      gap: var(--space-2xs);
    }
  }
</style>
