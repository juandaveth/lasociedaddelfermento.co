---
import { Image } from "astro:assets";
import RootDivider from "./illustrations/RootDivider.astro";
import heroPhoto from "../assets/hero_lsf.jpg";

const INSTAGRAM_URL = "https://www.instagram.com/lasociedaddelfermento";
---

<section id="top" class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1>
        La Sociedad<br />
        del Fermento
      </h1>
      <p class="hero-sub">
        Una comunidad abierta para curiosos, entusiastas y quienes se
        apasionan por la fermentación. Un espacio que da la bienvenida a
        quien quiera aprender, probar y compartir — del que hace parte
        <strong> El Parche Fermentero</strong>, nuestro encuentro quincenal.
      </p>
      <div class="hero-actions">
        <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="btn"
          >Escríbenos por Instagram</a
        >
        <a href="#parche" class="btn btn--outline">Ver el Parche</a>
      </div>
    </div>
    <div class="hero-art">
      <div class="photo-frame">
        <Image
          src={heroPhoto}
          alt="Frascos de fermentos preparados por la comunidad de La Sociedad del Fermento"
          widths={[400, 700, 1000]}
          sizes="(max-width: 800px) 90vw, 500px"
          class="photo"
        />
      </div>
    </div>
  </div>
  <RootDivider class="divider" />
</section>

<style>
  .hero {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    padding-bottom: 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 2rem;
  }

  h1 {
    font-size: clamp(2.6rem, 7vw, 5.2rem);
    margin: 0.6rem 0 1.4rem;
  }

  .hero-sub {
    max-width: 42ch;
    font-size: 1.15rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.6rem;
  }

  .hero-art {
    display: flex;
    justify-content: center;
  }

  .photo-frame {
    position: relative;
    width: min(420px, 85vw);
    height: min(315px, 63.75vw);
    overflow: hidden;
    border-radius: 6px;
    border: 3px solid var(--color-ink);
    box-shadow: 10px 10px 0 0 var(--color-mustard);
    transform: rotate(1.5deg);
  }

  .photo-frame .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .divider {
    width: 100%;
    height: 60px;
    color: var(--color-ink);
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  @media (max-width: 800px) {
    .hero-grid {
      grid-template-columns: 1fr;
      text-align: left;
    }

    .hero-art {
      order: -1;
    }
  }
</style>
