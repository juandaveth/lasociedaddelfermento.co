---
/**
 * Divisor de sección: una fila de burbujas huecas y desiguales, una tras otra.
 *
 * Los radios son los del anillo del sello. El SVG recorta los lados en vez
 * de estirarse ("slice"), para que las burbujas sigan siendo círculos en
 * cualquier ancho de pantalla.
 */
interface Props {
  class?: string;
}
const { class: klass = "" } = Astro.props;

const RADIOS = [4.2, 2, 3.1, 1.7, 3.8, 2.4, 1.6, 4.4, 2.2, 3.3, 1.8, 2.9, 3.6, 2.1];
const ESCALA = 2;
const SEPARACIONES = [4, 5.5, 4.5, 6.5, 4, 5];
const ANCHO = 2400;
const ALTO = 60;

const burbujas: { x: number; y: number; r: number; duracion: string; retraso: string }[] = [];
let x = 0;
for (let i = 0; x < ANCHO; i++) {
  const r = RADIOS[(i * 5 + Math.floor(i / 14) * 3) % RADIOS.length] * ESCALA;
  const cx = x + r;
  burbujas.push({
    x: Math.round(cx * 100) / 100,
    y: Math.round((ALTO / 2 + Math.sin(i * 2.4) * 3.2) * 100) / 100,
    r: Math.round(r * 100) / 100,
    // Mismo ritmo que las burbujas de Dónde: 3.2 a 4.8 s, cada una desfasada.
    duracion: (3.2 + (((i * 37) % 17) / 16) * 1.6).toFixed(2),
    retraso: ((((i * 53) % 41) / 41) * -4).toFixed(2),
  });
  x = cx + r + SEPARACIONES[i % SEPARACIONES.length];
}
---

<svg
  class={klass}
  viewBox={`0 0 ${ANCHO} ${ALTO}`}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  xmlns="http://www.w3.org/2000/svg"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
>
  {
    burbujas.map((b) => (
      <circle
        class="burbuja-divisor"
        cx={b.x}
        cy={b.y}
        r={b.r}
        style={`animation-duration:${b.duracion}s;animation-delay:${b.retraso}s`}
      />
    ))
  }
</svg>

<style>
  .burbuja-divisor {
    animation-name: flotar-divisor;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }

  @keyframes flotar-divisor {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-5px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .burbuja-divisor { animation: none !important; }
  }
</style>
