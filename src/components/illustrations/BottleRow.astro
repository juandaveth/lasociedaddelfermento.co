---
interface Props {
  class?: string;
}
const { class: klass = "" } = Astro.props;
---

<svg
  class={klass}
  viewBox="0 0 420 300"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <pattern id="hatch" width="6" height="6" patternTransform="rotate(48)" patternUnits="userSpaceOnUse">
      <line x1="0" y1="0" x2="0" y2="6" stroke="currentColor" stroke-width="1" />
    </pattern>
    <pattern id="crosshatch" width="6" height="6" patternTransform="rotate(48)" patternUnits="userSpaceOnUse">
      <line x1="0" y1="0" x2="0" y2="6" stroke="currentColor" stroke-width="1" />
      <line x1="0" y1="0" x2="6" y2="0" stroke="currentColor" stroke-width="1" />
    </pattern>
  </defs>

  <!-- left: jar with tied cloth lid -->
  <g>
    <path
      d="M18 120 Q14 108 30 104 Q46 98 62 104 Q78 108 74 120 L74 122 Q78 130 70 134 L70 250 Q70 268 44 268 Q18 268 18 250 L18 134 Q10 130 14 122 Z"
      stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"
    ></path>
    <path d="M18 134 L70 134" stroke="currentColor" stroke-width="2"></path>
    <path d="M28 152 Q44 250 60 152" stroke="currentColor" stroke-width="0" fill="url(#hatch)" opacity="0.5"></path>
    <path
      d="M22 152 L66 152 L66 250 Q66 262 44 262 Q22 262 22 250 Z"
      fill="url(#hatch)" opacity="0.45"
    ></path>
    <path d="M30 108 Q44 96 58 108" stroke="currentColor" stroke-width="1.6" opacity="0.7"></path>
    <path d="M44 134 Q30 150 44 190 Q30 205 40 230" stroke="currentColor" stroke-width="1.8" opacity="0.85"></path>
    <path d="M56 134 Q66 150 54 175" stroke="currentColor" stroke-width="1.8" opacity="0.85"></path>
    <circle cx="44" cy="134" r="2.6" fill="currentColor"></circle>
    <path d="M34 138 Q20 160 30 190 Q16 208 26 234" stroke="currentColor" stroke-width="1.4" opacity="0.6"></path>
  </g>

  <!-- middle: tall corked bottle, dark ferment inside -->
  <g>
    <path d="M180 20 L180 54" stroke="currentColor" stroke-width="2.4"></path>
    <path d="M164 8 L196 8 L196 54 L164 54 Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"></path>
    <path
      d="M156 54 L204 54 L204 70 Q214 100 214 160 L214 250 Q214 280 180 280 Q146 280 146 250 L146 160 Q146 100 156 70 Z"
      stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"
    ></path>
    <path
      d="M150 130 L210 130 L212 250 Q212 274 180 274 Q148 274 148 250 Z"
      fill="url(#crosshatch)" opacity="0.7"
    ></path>
    <path d="M150 130 Q180 138 210 130" stroke="currentColor" stroke-width="1.6" opacity="0.7"></path>
  </g>

  <!-- right: small swing-top bottle -->
  <g>
    <path d="M332 40 L332 20 Q332 12 340 12 L352 12 Q360 12 360 20 L360 40" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    <path d="M320 4 L372 4" stroke="currentColor" stroke-width="1.6" opacity="0.7"></path>
    <path d="M320 4 Q312 30 332 40" stroke="currentColor" stroke-width="1.6" opacity="0.7"></path>
    <path d="M372 4 Q380 30 360 40" stroke="currentColor" stroke-width="1.6" opacity="0.7"></path>
    <path
      d="M328 40 L364 40 L364 56 Q374 70 374 96 L374 168 Q374 190 346 190 Q318 190 318 168 L318 96 Q318 70 328 56 Z"
      stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"
    ></path>
    <path
      d="M320 110 L372 110 L372 168 Q372 184 346 184 Q320 184 320 168 Z"
      fill="url(#hatch)" opacity="0.5"
    ></path>
    <path d="M320 110 Q346 118 372 110" stroke="currentColor" stroke-width="1.4" opacity="0.7"></path>
  </g>
</svg>
