---
const INSTAGRAM_URL = "https://www.instagram.com/lasociedaddelfermento";
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="#top" class="wordmark">La Sociedad<br />del Fermento</a>
    <nav>
      <a href="#parche">El Parche</a>
      <a href="#sinfonia">Sinfonía</a>
      <a href="#blog">Blog</a>
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="btn btn--outline btn--sm"
        >Instagram</a
      >
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }

  .wordmark {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 1rem;
    line-height: 1;
    text-decoration: none;
    color: var(--color-ink);
    letter-spacing: 0.01em;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    font-weight: 600;
  }

  nav a:not(.btn) {
    text-decoration: none;
    color: var(--color-ink);
  }

  .btn--sm {
    padding: 0.55rem 1.1rem;
    font-size: 0.75rem;
  }

  @media (max-width: 640px) {
    nav a:not(.btn) {
      display: none;
    }
  }
</style>
