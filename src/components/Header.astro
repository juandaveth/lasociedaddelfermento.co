---
import Marca from "./illustrations/Marca.astro";

const INSTAGRAM_URL = "https://www.instagram.com/lasociedaddelfermento";
const APP_URL = "https://app.lasociedaddelfermento.co";
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="#top" class="lockup">
      <Marca variante="sello" class="marca" titulo="La Sociedad del Fermento" />
      <span class="lockup-nombre">La Sociedad<br />del Fermento</span>
    </a>
    <nav>
      <a href="#que-somos">Nosotros</a>
      <a href="#parche">El Parche</a>
      <a href="#manifiesto">Manifiesto</a>
      <a href="#donde">Dónde</a>
      <a href="#fermentemos">Fermentemos</a>
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="btn btn--outline btn--sm">Instagram</a>
      <a href={APP_URL} class="btn btn--sm">App</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky-nav);
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-rule);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-sm);
    padding-bottom: var(--space-sm);
  }

  /* gate 54/67: sentence case, no tracking */
  nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    font-family: var(--font-outlier);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  nav a:not(.btn) {
    text-decoration: none;
    color: var(--color-ink);
  }

  nav a:not(.btn):hover {
    color: var(--color-focus);
  }

  @media (max-width: 800px) {
    nav a:not(.btn) { display: none; }
    .lockup-nombre { display: none; }
  }
</style>
