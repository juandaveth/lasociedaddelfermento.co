---
import Marca from "./illustrations/Marca.astro";

const INSTAGRAM_URL = "https://www.instagram.com/lasociedaddelfermento";
const APP_URL = "https://app.lasociedaddelfermento.co";
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="#top" class="lockup">
      <Marca variante="sello" class="marca" titulo="La Sociedad del Fermento" />
      <span class="lockup-nombre">La Sociedad<br />del Fermento</span>
    </a>
    <nav>
      <a href="#parche">El Parche</a>
      <a href="#manifiesto">Manifiesto</a>
      <a href="#sinfonia">Sinfonía</a>
      <a href="#blog">Blog</a>
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="btn btn--outline btn--sm"
        >Instagram</a
      >
      <a href={APP_URL} class="btn btn--sm">App</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-sm);
    padding-bottom: var(--space-sm);
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    font-size: 0.8rem;
    font-weight: 600;
  }

  nav a:not(.btn) {
    text-decoration: none;
    color: var(--color-ink);
  }

  @media (max-width: 640px) {
    nav a:not(.btn) {
      display: none;
    }

    /* En móvil el bloque LSDF carga solo la marca. */
    .lockup-nombre {
      display: none;
    }
  }
</style>
