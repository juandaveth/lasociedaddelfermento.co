---
const INSTAGRAM_URL = "https://www.instagram.com/lasociedaddelfermento";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <p class="wordmark">La Sociedad<br />del Fermento</p>
    <div class="footer-meta">
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener">@lasociedaddelfermento</a>
      <span>Medellín, Colombia</span>
      <span>© {year}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    padding: 2.5rem 0;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
  }

  .wordmark {
    font-family: var(--font-display);
    text-transform: uppercase;
    line-height: 1;
    margin: 0;
    font-size: 1rem;
  }

  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.75rem;
    opacity: 0.75;
  }

  .footer-meta a {
    text-decoration: none;
    color: var(--color-terracotta);
    font-weight: 600;
  }
</style>
