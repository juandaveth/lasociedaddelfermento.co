---
import Marca from "./illustrations/Marca.astro";

const INSTAGRAM_URL = "https://www.instagram.com/lasociedaddelfermento";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div class="lockup">
      <Marca variante="bloque" class="marca" />
      <p class="lockup-nombre">La Sociedad<br />del Fermento</p>
    </div>
    <div class="footer-meta">
      <a href={INSTAGRAM_URL} target="_blank" rel="noopener">@lasociedaddelfermento</a>
      <span>Medellín, Colombia</span>
      <span>© {year}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    padding: var(--space-xl) 0;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-md);
  }

  /* gate 54/67: sentence case, no tracking */
  .footer-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-family: var(--font-outlier);
    font-size: var(--text-sm);
    opacity: 0.75;
  }

  .footer-meta a {
    text-decoration: none;
    color: var(--color-ink);
    font-weight: 600;
  }
</style>
