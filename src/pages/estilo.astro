---
import Layout from "../layouts/Layout.astro";
import Marca from "../components/illustrations/Marca.astro";
import RootDivider from "../components/illustrations/RootDivider.astro";

const pigmentos = [
  { nombre: "--lsdf-crema", hex: "#f5eedc", rol: "Fondo por defecto" },
  { nombre: "--lsdf-crema-honda", hex: "#ede2c6", rol: "Fondo de sección alterna" },
  { nombre: "--lsdf-tinta", hex: "#1a1610", rol: "Texto y superficie oscura" },
  { nombre: "--lsdf-tinta-honda", hex: "#241f17", rol: "Alterna dentro de lo oscuro" },
  { nombre: "--lsdf-mostaza", hex: "#e6ab1e", rol: "Acento gráfico: sombra, badge, borde" },
  { nombre: "--lsdf-terracota", hex: "#a83d1f", rol: "Acento tipográfico: eyebrow, dt, link" },
];

const roles = [
  { rol: "--color-bg", claro: "crema", oscuro: "tinta" },
  { rol: "--color-bg-alt", claro: "crema honda", oscuro: "tinta honda" },
  { rol: "--color-ink", claro: "tinta", oscuro: "crema" },
  { rol: "--color-accent", claro: "mostaza", oscuro: "mostaza" },
  { rol: "--color-accent-ink", claro: "terracota", oscuro: "mostaza" },
  { rol: "--color-line", claro: "tinta 15%", oscuro: "crema 22%" },
];

const escalaTexto = [
  { token: "--text-h1", uso: "Título de portada", clase: "d-h1" },
  { token: "--text-h2", uso: "Título de sección", clase: "d-h2" },
  { token: "--text-h3", uso: "Subtítulo", clase: "d-h3" },
  { token: "--text-lg", uso: "Bajada (.lead)", clase: "d-lg" },
  { token: "--text-base", uso: "Cuerpo", clase: "d-base" },
  { token: "--text-md", uso: "Botón, metadato", clase: "d-md" },
  { token: "--text-sm", uso: "Eyebrow", clase: "d-sm" },
  { token: "--text-xs", uso: "Badge", clase: "d-xs" },
];

const espacios = [
  ["--space-2xs", "0.3rem"],
  ["--space-xs", "0.5rem"],
  ["--space-sm", "0.9rem"],
  ["--space-md", "1.2rem"],
  ["--space-lg", "1.6rem"],
  ["--space-xl", "2.5rem"],
  ["--space-2xl", "3.5rem"],
];
---

<Layout
  title="Sistema de diseño — La Sociedad del Fermento"
  description="Tokens, marca y componentes de LSDF. Página interna de referencia."
  noindex
>
  <header class="guia-header">
    <div class="wrap">
      <p class="eyebrow">Referencia interna</p>
      <h1>Sistema<br />LSDF</h1>
      <p class="lead">
        Todo lo que hay aquí se lee del mismo <code>global.css</code> que usa el
        sitio. Si un token cambia, esta página cambia con él.
      </p>
    </div>
    <RootDivider class="divider" />
  </header>

  <!-- ================= LA SIGLA ================= -->
  <section>
    <div class="wrap">
      <p class="eyebrow">01 — Marca</p>
      <h2>La sigla</h2>
      <p class="lead">
        Cuatro letras, cuatro golpes: <strong>L·S·D·F</strong>. Están dibujadas
        como vectores propios sobre una retícula de 28 de alto y asta de 6, no
        compuestas en Anton. Eso significa que el logo no depende de que cargue
        una webfont y se ve igual en el favicon, en un sticker y en la puerta
        del Escampadero.
      </p>

      <div class="variantes">
        <figure class="variante">
          <div class="lienzo m-sello"><Marca variante="sello" /></div>
          <figcaption>
            <strong>Sello · principal</strong>
            <span
              >La marca oficial. Bloque dentro de un anillo de burbujas de
              tamaños desiguales: una sociedad tiene sello, y este además
              fermenta. Va en el header, el avatar y los stickers.</span
            >
            <code>&lt;Marca variante="sello" /&gt;</code>
          </figcaption>
        </figure>

        <figure class="variante">
          <div class="lienzo m-bloque"><Marca variante="bloque" /></div>
          <figcaption>
            <strong>Bloque · variante</strong>
            <span
              >2×2, sin anillo. Cuando hay poco espacio horizontal o el tamaño
              es tan pequeño que las burbujas se vuelven textura: favicon,
              pie de página.</span
            >
            <code>&lt;Marca variante="bloque" /&gt;</code>
          </figcaption>
        </figure>

        <figure class="variante">
          <div class="lienzo m-frasco"><Marca variante="frasco" /></div>
          <figcaption>
            <strong>Frasco · variante</strong>
            <span
              >La sigla dentro de un frasco de cierre mecánico, el del chucrut.
              El vidrio es línea fina, las letras van macizas: el frasco
              contiene la sigla igual que contiene el fermento. Para camisetas,
              etiquetas y afiches del Parche.</span
            >
            <code>&lt;Marca variante="frasco" /&gt;</code>
          </figcaption>
        </figure>

        <figure class="variante">
          <div class="lienzo m-fila"><Marca variante="fila" /></div>
          <figcaption>
            <strong>Fila · variante</strong>
            <span
              >Horizontal, una sola línea. Para cabeceras muy anchas, firmas de
              correo y créditos al pie de una pieza.</span
            >
            <code>&lt;Marca variante="fila" /&gt;</code>
          </figcaption>
        </figure>
      </div>

      <h3 class="sub">Aplicaciones</h3>
      <div class="aplicaciones">
        <figure class="app">
          <div class="app-lienzo">
            <div class="lockup">
              <Marca variante="sello" class="marca" />
              <span class="lockup-nombre">La Sociedad<br />del Fermento</span>
            </div>
          </div>
          <figcaption>Lockup de header: sello + nombre completo.</figcaption>
        </figure>

        <figure class="app">
          <div class="app-lienzo app-avatar">
            <div class="avatar"><Marca variante="avatar" /></div>
          </div>
          <figcaption>
            Avatar de Instagram: tinta sobre mostaza. Lleva las burbujas del
            sello pero no el aro, porque el borde del círculo ya hace esa
            línea y repetirla la ensucia.
          </figcaption>
        </figure>

        <figure class="app">
          <div class="app-lienzo app-cartel">
            <div class="cartel"><Marca variante="bloque" /></div>
          </div>
          <figcaption>Escala de cartel: la sigla sola, sin nombre.</figcaption>
        </figure>

        <figure class="app">
          <div class="app-lienzo app-camiseta">
            <div class="camiseta"><Marca variante="frasco" /></div>
          </div>
          <figcaption>Camiseta o etiqueta: el frasco en crema sobre tinta.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ================= COLOR ================= -->
  <section class="alterna">
    <div class="wrap">
      <p class="eyebrow">02 — Color</p>
      <h2>Pigmentos</h2>
      <p class="lead">
        Seis valores crudos. Los componentes nunca los usan directo: usan roles.
      </p>

      <ul class="pigmentos">
        {
          pigmentos.map((p) => (
            <li class="pigmento">
              <span class="muestra" style={`background:${p.hex}`} />
              <div>
                <code>{p.nombre}</code>
                <span class="hex">{p.hex}</span>
                <span class="rol">{p.rol}</span>
              </div>
            </li>
          ))
        }
      </ul>

      <h3 class="sub">Roles por superficie</h3>
      <p>
        Esta es la pieza que faltaba. Antes, cada sección oscura tenía que
        repintar sus botones a mano. Ahora basta con
        <code>data-surface="ink"</code> y todo se invierte solo.
      </p>
      <div class="tabla-scroll">
        <table>
          <thead>
            <tr><th>Rol</th><th>Superficie clara</th><th>data-surface="ink"</th></tr>
          </thead>
          <tbody>
            {
              roles.map((r) => (
                <tr>
                  <td><code>{r.rol}</code></td>
                  <td>{r.claro}</td>
                  <td>{r.oscuro}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="nota">
        Terracota sobre tinta no alcanza contraste legible, por eso en oscuro el
        rol de acento tipográfico lo toma mostaza. Es la única sustitución del
        sistema y está resuelta en un solo lugar.
      </p>
    </div>
  </section>

  <!-- ================= TIPOGRAFÍA ================= -->
  <section>
    <div class="wrap">
      <p class="eyebrow">03 — Tipografía</p>
      <h2>Tres voces</h2>

      <div class="voces">
        <div class="voz">
          <p class="voz-muestra f-display">Fermento</p>
          <code>--font-display</code>
          <span>Anton. Solo titulares, siempre en mayúscula.</span>
        </div>
        <div class="voz">
          <p class="voz-muestra f-body">Fermento</p>
          <code>--font-body</code>
          <span>Fraunces. Cuerpo, bajadas y nombres de obra en cursiva.</span>
        </div>
        <div class="voz">
          <p class="voz-muestra f-label">Fermento</p>
          <code>--font-label</code>
          <span>Work Sans. Eyebrows, botones, metadatos, navegación.</span>
        </div>
      </div>

      <h3 class="sub">Escala</h3>
      <ul class="escala">
        {
          escalaTexto.map((t) => (
            <li>
              <span class={`ejemplo ${t.clase}`}>Fermentar es esperar</span>
              <span class="escala-meta">
                <code>{t.token}</code>
                <span>{t.uso}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ================= ESPACIO Y FORMA ================= -->
  <section class="alterna">
    <div class="wrap">
      <p class="eyebrow">04 — Espacio y forma</p>
      <h2>Escala</h2>
      <p class="lead">
        Antes había veinte valores escogidos a mano. Ahora hay siete, más el
        alto de sección fluido.
      </p>

      <ul class="espacios">
        {
          espacios.map(([token, valor]) => (
            <li>
              <span class="barra" style={`width:var(${token})`} />
              <code>{token}</code>
              <span class="valor">{valor}</span>
            </li>
          ))
        }
      </ul>

      <h3 class="sub">Radios y sombra</h3>
      <div class="formas">
        <div class="forma">
          <div class="caja-radio r-sm"></div>
          <code>--radius-sm · 4px</code>
        </div>
        <div class="forma">
          <div class="caja-radio r-md"></div>
          <code>--radius-md · 6px</code>
        </div>
        <div class="forma">
          <div class="caja-radio r-pill"></div>
          <code>--radius-pill · 999px</code>
        </div>
        <div class="forma">
          <div class="caja-radio r-sombra"></div>
          <code>--shadow-dura</code>
        </div>
      </div>
      <p class="nota">
        La sombra dura nunca lleva desenfoque. Es un desplazamiento sólido en
        mostaza: la firma de la marca, igual que en el marco de la foto de
        portada.
      </p>
    </div>
  </section>

  <!-- ================= COMPONENTES ================= -->
  <section>
    <div class="wrap">
      <p class="eyebrow">05 — Componentes</p>
      <h2>Piezas</h2>

      <h3 class="sub">Botones</h3>
      <div class="fila-piezas">
        <a href="#" class="btn">Primario</a>
        <a href="#" class="btn btn--outline">Contorno</a>
        <a href="#" class="btn btn--sm">Pequeño</a>
        <a href="#" class="btn btn--outline btn--sm">Contorno pequeño</a>
      </div>
      <p class="nota">
        Prueba el tabulador: ahora todo lo enfocable tiene anillo de foco. Antes
        no existía ninguno, y con teclado el sitio era imposible de recorrer.
      </p>

      <h3 class="sub">Rótulos</h3>
      <div class="fila-piezas alineada">
        <span class="badge">Próximamente</span>
        <span class="eyebrow">Eyebrow de sección</span>
        <span class="meta">Metadato · 5:00 p.m.</span>
      </div>

      <h3 class="sub">Caja de énfasis</h3>
      <div class="caja">
        <span class="badge">Próximo encuentro</span>
        <h3 class="caja-titulo">Hálito. Escucha colectiva</h3>
        <p class="meta">Viernes 31 de julio · Exploratorio</p>
        <p>Borde mostaza, radio pequeño, ancho máximo de 62 caracteres.</p>
        <a href="#" class="btn btn--outline">Ver evento</a>
      </div>
    </div>
  </section>

  <!-- ================= SUPERFICIE OSCURA ================= -->
  <section data-surface="ink">
    <div class="wrap">
      <p class="eyebrow">06 — Inversión</p>
      <h2>Superficie oscura</h2>
      <p class="lead">
        Esta sección entera es <code>data-surface="ink"</code>. No hay una sola
        regla de color escrita aquí: los mismos componentes de arriba se
        invierten porque leen roles, no pigmentos.
      </p>
      <div class="fila-piezas">
        <a href="#" class="btn">Primario</a>
        <a href="#" class="btn btn--outline">Contorno</a>
        <span class="badge">Badge</span>
      </div>
      <div class="caja caja-espaciada">
        <p class="meta">Metadato invertido</p>
        <p>Idéntico marcado al de la sección clara.</p>
      </div>
      <div class="m-fila m-fila-oscura"><Marca variante="fila" /></div>
    </div>
    <RootDivider class="divider" />
  </section>

  <footer class="guia-footer">
    <div class="wrap">
      <div class="lockup">
        <Marca variante="bloque" class="marca" />
        <p class="lockup-nombre">La Sociedad<br />del Fermento</p>
      </div>
      <p class="nota">
        Página interna. No está enlazada desde la navegación del sitio.
      </p>
    </div>
  </footer>
</Layout>

<style>
  .guia-header {
    padding-top: var(--space-2xl);
  }

  .guia-header h1 {
    margin: var(--space-2xs) 0 var(--space-md);
  }

  .alterna {
    background: var(--color-bg-alt);
  }

  h2 {
    margin: var(--space-2xs) 0 var(--space-md);
  }

  .sub {
    margin: var(--space-2xl) 0 var(--space-md);
    font-size: var(--text-md);
    letter-spacing: var(--track-eyebrow);
    color: var(--color-accent-ink);
    font-family: var(--font-label);
  }

  code {
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
    font-size: 0.8em;
    background: color-mix(in srgb, var(--color-ink) 8%, transparent);
    padding: 0.1em 0.4em;
    border-radius: 3px;
  }

  .nota {
    font-size: 0.9rem;
    opacity: 0.75;
    max-width: var(--medida);
    margin-top: var(--space-md);
  }

  /* ---------- Marca ---------- */
  .variantes,
  .aplicaciones {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  .variante,
  .app {
    margin: 0;
  }

  .lienzo,
  .app-lienzo {
    display: grid;
    place-items: center;
    padding: var(--space-xl) var(--space-md);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    min-height: 160px;
  }

  .m-fila :global(svg) {
    width: 150px;
    height: auto;
  }

  .m-bloque :global(svg) {
    width: 68px;
    height: auto;
  }

  .m-sello :global(svg) {
    width: 108px;
    height: auto;
  }

  .m-frasco :global(svg) {
    width: 82px;
    height: auto;
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    margin-top: var(--space-sm);
    font-size: 0.9rem;
  }

  figcaption strong {
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    font-size: var(--text-sm);
  }

  figcaption code {
    align-self: flex-start;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--lsdf-tinta);
  }

  .avatar :global(svg) {
    width: 88px;
    height: auto;
  }

  .app-cartel {
    background: var(--lsdf-tinta);
  }

  .cartel {
    color: var(--lsdf-crema);
  }

  .cartel :global(svg) {
    width: 110px;
    height: auto;
  }

  .app-camiseta {
    background: var(--lsdf-tinta);
  }

  .camiseta {
    color: var(--lsdf-crema);
  }

  .camiseta :global(svg) {
    width: 92px;
    height: auto;
  }

  .m-fila-oscura {
    margin-top: var(--space-xl);
  }

  /* ---------- Color ---------- */
  .pigmentos {
    list-style: none;
    padding: 0;
    margin: var(--space-lg) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-md);
  }

  .pigmento {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
  }

  .muestra {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-line);
  }

  .pigmento div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .pigmento code {
    align-self: flex-start;
  }

  .hex {
    font-family: var(--font-label);
    font-size: 0.8rem;
    opacity: 0.7;
  }

  .rol {
    font-size: 0.85rem;
  }

  .tabla-scroll {
    overflow-x: auto;
    margin-top: var(--space-md);
  }

  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 480px;
    font-size: 0.9rem;
  }

  th,
  td {
    text-align: left;
    padding: var(--space-xs) var(--space-sm);
    border-bottom: 1px solid var(--color-line);
  }

  th {
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    font-size: var(--text-xs);
  }

  /* ---------- Tipografía ---------- */
  .voces {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  .voz {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: flex-start;
  }

  .voz-muestra {
    font-size: 2.6rem;
    line-height: 1.1;
    margin: 0;
  }

  .voz span {
    font-size: 0.85rem;
    opacity: 0.8;
  }

  .f-display {
    font-family: var(--font-display);
    text-transform: uppercase;
  }

  .f-body {
    font-family: var(--font-body);
  }

  .f-label {
    font-family: var(--font-label);
    font-weight: 600;
  }

  .escala {
    list-style: none;
    padding: 0;
    margin: var(--space-lg) 0 0;
    display: grid;
    gap: var(--space-md);
  }

  .escala li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-line);
  }

  .escala-meta {
    display: flex;
    gap: var(--space-sm);
    align-items: baseline;
    font-size: 0.8rem;
    opacity: 0.75;
    flex: none;
  }

  .d-h1,
  .d-h2,
  .d-h3 {
    font-family: var(--font-display);
    text-transform: uppercase;
    line-height: var(--leading-tight);
  }

  .d-h1 {
    font-size: var(--text-h1);
  }
  .d-h2 {
    font-size: var(--text-h2);
  }
  .d-h3 {
    font-size: var(--text-h3);
  }
  .d-lg {
    font-size: var(--text-lg);
  }
  .d-base {
    font-size: var(--text-base);
  }
  .d-md {
    font-size: var(--text-md);
    font-family: var(--font-label);
  }
  .d-sm {
    font-size: var(--text-sm);
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: var(--track-eyebrow);
  }
  .d-xs {
    font-size: var(--text-xs);
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: var(--track-badge);
  }

  /* ---------- Espacio y forma ---------- */
  .espacios {
    list-style: none;
    padding: 0;
    margin: var(--space-lg) 0 0;
    display: grid;
    gap: var(--space-xs);
  }

  .espacios li {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.85rem;
  }

  .barra {
    height: 18px;
    background: var(--color-accent);
    border-radius: 2px;
    flex: none;
  }

  .valor {
    opacity: 0.6;
  }

  .formas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    margin-top: var(--space-lg);
    padding-right: 14px;
  }

  .forma {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    align-items: flex-start;
  }

  .caja-radio {
    width: 84px;
    height: 56px;
    border: var(--border-fuerte) solid var(--color-ink);
  }

  .r-sm {
    border-radius: var(--radius-sm);
  }
  .r-md {
    border-radius: var(--radius-md);
  }
  .r-pill {
    border-radius: var(--radius-pill);
  }
  .r-sombra {
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-dura-sm);
  }

  /* ---------- Componentes ---------- */
  .fila-piezas {
