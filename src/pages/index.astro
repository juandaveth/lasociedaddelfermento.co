---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import QuesSomos from "../components/QuesSomos.astro";
import QueHacemos from "../components/QueHacemos.astro";
import ElParche from "../components/ElParche.astro";
import QuienesSomos from "../components/QuienesSomos.astro";
import Manifiesto from "../components/Manifiesto.astro";
import Donde from "../components/Donde.astro";
import Fermentemos from "../components/Fermentemos.astro";
import Footer from "../components/Footer.astro";
import RootDivider from "../components/illustrations/RootDivider.astro";
---

<Layout>
  <Header />
  <main>
    <Hero />
    <QuesSomos />
    <QueHacemos />
    <RootDivider class="divider divider--alterna" />
    <ElParche />
    <QuienesSomos />
    <Manifiesto />
    <Donde />
    <Fermentemos />
  </main>
  <Footer />
</Layout>
