<script>
  // Copia el texto plano, con un salto de línea en blanco entre párrafos,
  // que es lo que espera un campo de formulario.
  document.querySelectorAll<HTMLButtonElement>("[data-copiar]").forEach((boton) => {
    boton.addEventListener("click", async () => {
      const id = boton.dataset.copiar!;
      const parrafos = document.querySelectorAll(`#${id} .texto-cuerpo p`);
      const texto = Array.from(parrafos, (p) => p.textContent?.trim()).join("\n\n");
      try {
        await navigator.clipboard.writeText(texto);
        boton.textContent = "Copiado";
      } catch {
        boton.textContent = "Selecciona y copia";
      }
      setTimeout(() => (boton.textContent = "Copiar"), 2000);
    });
  });
</script>

