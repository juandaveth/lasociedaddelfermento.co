---
import Layout from "../layouts/Layout.astro";
import Marca from "../components/illustrations/Marca.astro";
import RootDivider from "../components/illustrations/RootDivider.astro";

const pigmentos = [
  { nombre: "--lsdf-crema", hex: "#f5eedc", rol: "Fondo por defecto" },
  { nombre: "--lsdf-crema-honda", hex: "#ede2c6", rol: "Fondo de sección alterna" },
  { nombre: "--lsdf-tinta", hex: "#1a1610", rol: "Texto y superficie oscura" },
  { nombre: "--lsdf-tinta-honda", hex: "#241f17", rol: "Alterna dentro de lo oscuro" },
  { nombre: "--lsdf-mostaza", hex: "#e6ab1e", rol: "Acento gráfico: sombra, badge, borde" },
  { nombre: "--lsdf-terracota", hex: "#a83d1f", rol: "Acento tipográfico: eyebrow, dt, link" },
];

// CMYK convertido desde sRGB con los perfiles CoatedFOGRA39 y UncoatedFOGRA29,
// intención colorimétrica relativa. Punto de partida, no verdad: la imprenta
// manda con su prueba de color.
const tintasImpresion = [
  { color: "Mostaza", hex: "#e6ab1e", estucado: "9 · 35 · 98 · 1", bond: "10 · 29 · 100 · 0", pantone: "≈ 124 C", uso: "Fondo de sticker, segunda tinta del fanzine." },
  { color: "Terracota", hex: "#a83d1f", estucado: "24 · 88 · 100 · 18", bond: "22 · 98 · 100 · 24", pantone: "≈ 1675 C", uso: "Titulares y detalles sobre crema. Nunca sobre tinta." },
  { color: "Tinta", hex: "#1a1610", estucado: "Texto: 0 · 0 · 0 · 100\nFondo: 60 · 50 · 50 · 100", bond: "Texto: 0 · 0 · 0 · 100\nFondo: 60 · 50 · 50 · 100", pantone: "Negro de proceso", uso: "Texto en K puro. Áreas grandes en negro enriquecido." },
  { color: "Crema", hex: "#f5eedc", estucado: "No se imprime", bond: "No se imprime", pantone: "Papel", uso: "Es el papel: pide hueso o crema en vez de imprimir el fondo." },
];


// Textos para convocatorias. Solo afirman lo que ya existe (sitio, app,
// manifiesto). Nada de iniciativas que el grupo no haya decidido.
const textos = [
  {
    id: "corto",
    nombre: "Corto",
    para: "Casillas de un párrafo, bios de redes, pie de una pieza.",
    parrafos: [
      "La Sociedad del Fermento es un colectivo de Medellín que hace comunidad alrededor de la fermentación. En el Parche Fermentero, un encuentro abierto e itinerante, cocinamos juntos, compartimos saberes y probamos lo que ha burbujeado en casa. Para nosotros un fermento es una tecnología viva: cuidarlo es aprender a cuidarnos.",
    ],
  },
  {
    id: "medio",
    nombre: "Medio",
    para: "\"Descripción del colectivo\" en la mayoría de formularios.",
    parrafos: [
      "La Sociedad del Fermento es un colectivo de Medellín que se reúne alrededor de la fermentación como práctica de cocina, de salud y de comunidad. Somos un proceso colectivo, abierto a cualquier persona con curiosidad y sin experiencia previa.",
      "Nuestro espacio central es el Parche Fermentero: encuentros itinerantes en casas, librerías y espacios culturales de la ciudad, donde preparamos fermentos juntos, intercambiamos técnicas y probamos lo que cada quien trae. También hacemos catas abiertas y lotes de producción colectiva, como el kimchi, cuya venta ayuda a sostener el proyecto.",
      "Trabajamos como un laboratorio: experimentamos, documentamos y compartimos lo aprendido. Nos interesan la relación entre alimento y ánimo, la salud digestiva, la autogestión y los saberes que permiten conservar comida sin refrigeración.",
    ],
  },
  {
    id: "largo",
    nombre: "Largo",
    para: "Convocatorias con sección de trayectoria, propuesta o justificación.",
    parrafos: [
      "La Sociedad del Fermento es un colectivo de Medellín que se reúne alrededor de la fermentación como práctica de cocina, de salud y de comunidad. Somos un proceso colectivo, abierto a cualquier persona con curiosidad y sin experiencia previa.",
      "Nuestro espacio central es el Parche Fermentero: encuentros itinerantes en casas, librerías y espacios culturales de la ciudad, donde preparamos fermentos juntos, intercambiamos técnicas y probamos lo que cada quien trae. También hacemos catas abiertas y lotes de producción colectiva, como el kimchi, cuya venta ayuda a sostener el proyecto. Para coordinarnos construimos nuestra propia aplicación, donde la comunidad reserva cupo en los encuentros y llevamos el inventario de cada lote.",
      "Trabajamos como un laboratorio: experimentamos, documentamos y compartimos lo aprendido. Nos interesan la relación entre alimento y ánimo, la salud digestiva, la autogestión y los saberes que permiten conservar comida sin refrigeración, útiles en una emergencia.",
      "Nuestro manifiesto lo resume así: «Las ideas juntas fermentan mejor que existiendo separadas». Y lo cierra con un compromiso: creemos en el bienestar como código abierto, y ningún saber sobre el fermento se vende, se esconde ni se monopoliza.",
    ],
  },
].map((t) => ({
  ...t,
  palabras: t.parrafos.join(" ").split(/\s+/).filter(Boolean).length,
}));

const fichaDatos = [
  ["Nombre", "La Sociedad del Fermento"],
  ["Sigla", "LSDF"],
  ["Ciudad", "Medellín, Colombia"],
  ["Sitio web", "lasociedaddelfermento.co"],
  ["Instagram", "@lasociedaddelfermento"],
];

// Archivos exportados en public/marca/ con scripts/exportar-marca.mjs.
// Negro y crema salen transparentes: crema es para fondos oscuros.
// Si se exporta una variante nueva, se agrega aquí.
const descargas = [
  {
    nombre: "Sello",
    variante: "sello",
    uso: "La marca principal. Stickers, afiches, fanzines.",
    versiones: [
      { tinta: "Negro", archivo: "lsdf-sello-negro" },
      { tinta: "Crema", archivo: "lsdf-sello-crema" },
    ],
  },
  {
    nombre: "Bloque",
    variante: "bloque",
    uso: "Sin anillo. Por debajo de 15 mm, donde el sello ya no se lee.",
    versiones: [
      { tinta: "Negro", archivo: "lsdf-bloque-negro" },
      { tinta: "Crema", archivo: "lsdf-bloque-crema" },
    ],
  },
  {
    nombre: "Fila",
    variante: "fila",
    uso: "Una línea. Créditos al pie de una pieza, firmas, cabeceras anchas.",
    versiones: [
      { tinta: "Negro", archivo: "lsdf-fila-negro" },
      { tinta: "Crema", archivo: "lsdf-fila-crema" },
    ],
  },
  {
    nombre: "Frasco",
    variante: "frasco",
    uso: "Camisetas, etiquetas y afiches. A una tinta, las burbujas van sólidas.",
    versiones: [
      { tinta: "Negro", archivo: "lsdf-frasco-negro" },
      { tinta: "Crema", archivo: "lsdf-frasco-crema" },
    ],
  },
  {
    nombre: "Avatar",
    variante: "avatar",
    uso: "Burbujas sin el aro. La versión sobre mostaza es la foto de perfil de redes, que no admite transparencia.",
    versiones: [
      { tinta: "Negro", archivo: "lsdf-avatar-negro" },
      { tinta: "Sobre mostaza", archivo: "lsdf-avatar-negro-sobre-mostaza" },
    ],
  },
] as const;

const anchosPng = [2048, 512, 128];

const minimos = [
  { variante: "sello", medida: "15 mm de diámetro", por: "La burbuja más pequeña mide 0,4 mm y el aro 0,3 mm. Más chico, se cierran." },
  { variante: "bloque", medida: "8 mm de ancho", por: "Las contraformas de la S y la D siguen abiertas." },
  { variante: "fila", medida: "12 mm de ancho", por: "Mismas letras que el bloque, puestas en línea." },
  { variante: "frasco", medida: "25 mm de ancho", por: "El vidrio es línea fina y las burbujas van al 60%: es la variante más frágil." },
];

const roles = [
  { rol: "--color-bg", claro: "crema", oscuro: "tinta" },
  { rol: "--color-bg-alt", claro: "crema honda", oscuro: "tinta honda" },
  { rol: "--color-ink", claro: "tinta", oscuro: "crema" },
  { rol: "--color-accent", claro: "mostaza", oscuro: "mostaza" },
  { rol: "--color-accent-ink", claro: "terracota", oscuro: "mostaza" },
  { rol: "--color-line", claro: "tinta 15%", oscuro: "crema 22%" },
];

const escalaTexto = [
  { token: "--text-h1", uso: "Título de portada", clase: "d-h1" },
  { token: "--text-h2", uso: "Título de sección", clase: "d-h2" },
  { token: "--text-h3", uso: "Subtítulo", clase: "d-h3" },
  { token: "--text-lg", uso: "Bajada (.lead)", clase: "d-lg" },
  { token: "--text-base", uso: "Cuerpo", clase: "d-base" },
  { token: "--text-md", uso: "Botón, metadato", clase: "d-md" },
  { token: "--text-sm", uso: "Eyebrow", clase: "d-sm" },
  { token: "--text-xs", uso: "Badge", clase: "d-xs" },
];

const espacios = [
  ["--space-2xs", "0.3rem"],
  ["--space-xs", "0.5rem"],
  ["--space-sm", "0.9rem"],
  ["--space-md", "1.2rem"],
  ["--space-lg", "1.6rem"],
  ["--space-xl", "2.5rem"],
  ["--space-2xl", "3.5rem"],
];
---

<Layout
  title="Brandbook · La Sociedad del Fermento"
  description="Marca, color, impresión y sistema de diseño de LSDF. Uso interno."
  noindex
>
  <header class="guia-header">
    <div class="wrap">
      <p class="eyebrow">Uso interno</p>
      <h1>Brandbook<br />LSDF</h1>
      <p class="lead">
        Para aplicar a convocatorias, mandar a imprimir stickers y armar
        fanzines. Los colores y la marca se leen del mismo <code>global.css</code>
        que usa el sitio: si un token cambia, esta página cambia con él.
      </p>
    </div>
    <RootDivider class="divider" />
  </header>

  <!-- ================= LA SIGLA ================= -->
  <section>
    <div class="wrap">
      <p class="eyebrow">01 · Marca</p>
      <h2>La sigla</h2>
      <p class="lead">
        Cuatro letras, cuatro golpes: <strong>L·S·D·F</strong>. Están dibujadas
        como vectores propios sobre una retícula de 28 de alto y asta de 6, no
        compuestas en Anton. Eso significa que el logo no depende de que cargue
        una webfont y se ve igual en el favicon, en un sticker y en la tapa
        de un frasco.
      </p>

      <div class="variantes">
        <figure class="variante">
          <div class="lienzo m-sello"><Marca variante="sello" /></div>
          <figcaption>
            <strong>Sello · principal</strong>
            <span
              >La marca oficial. Bloque dentro de un anillo de burbujas de
              tamaños desiguales: una sociedad tiene sello, y este además
              fermenta. Va en el header, el avatar y los stickers.</span
            >
            <code>&lt;Marca variante="sello" /&gt;</code>
          </figcaption>
        </figure>

        <figure class="variante">
          <div class="lienzo m-bloque"><Marca variante="bloque" /></div>
          <figcaption>
            <strong>Bloque · variante</strong>
            <span
              >2×2, sin anillo. Cuando hay poco espacio horizontal o el tamaño
              es tan pequeño que las burbujas se vuelven textura: favicon,
              pie de página.</span
            >
            <code>&lt;Marca variante="bloque" /&gt;</code>
          </figcaption>
        </figure>

        <figure class="variante">
          <div class="lienzo m-frasco"><Marca variante="frasco" /></div>
          <figcaption>
            <strong>Frasco · variante</strong>
            <span
              >La sigla dentro de un frasco de cierre mecánico, el del chucrut.
              El vidrio es línea fina, las letras van macizas: el frasco
              contiene la sigla igual que contiene el fermento. Para camisetas,
              etiquetas y afiches del Parche.</span
            >
            <code>&lt;Marca variante="frasco" /&gt;</code>
          </figcaption>
        </figure>

        <figure class="variante">
          <div class="lienzo m-fila"><Marca variante="fila" /></div>
          <figcaption>
            <strong>Fila · variante</strong>
            <span
              >Horizontal, una sola línea. Para cabeceras muy anchas, firmas de
              correo y créditos al pie de una pieza.</span
            >
            <code>&lt;Marca variante="fila" /&gt;</code>
          </figcaption>
        </figure>
      </div>

      <h3 class="sub">Aplicaciones</h3>
      <div class="aplicaciones">
        <figure class="app">
          <div class="app-lienzo">
            <div class="lockup">
              <Marca variante="sello" class="marca" />
              <span class="lockup-nombre">La Sociedad<br />del Fermento</span>
            </div>
          </div>
          <figcaption>Lockup de header: sello + nombre completo.</figcaption>
        </figure>

        <figure class="app">
          <div class="app-lienzo app-avatar">
            <div class="avatar"><Marca variante="avatar" /></div>
          </div>
          <figcaption>
            Avatar de Instagram: tinta sobre mostaza. Lleva las burbujas del
            sello pero no el aro, porque el borde del círculo ya hace esa
            línea y repetirla la ensucia.
          </figcaption>
        </figure>

        <figure class="app">
          <div class="app-lienzo app-cartel">
            <div class="cartel"><Marca variante="bloque" /></div>
          </div>
          <figcaption>Escala de cartel: la sigla sola, sin nombre.</figcaption>
        </figure>

        <figure class="app">
          <div class="app-lienzo app-camiseta">
            <div class="camiseta"><Marca variante="frasco" /></div>
          </div>
          <figcaption>Camiseta o etiqueta: el frasco en crema sobre tinta.</figcaption>
        </figure>
      </div>

      <h3 class="sub" id="descargas">Descargas</h3>
      <p class="lead-corto">
        <strong>SVG</strong> es vectorial: escala sin perder calidad y es el que
        hay que mandar a la imprenta. <strong>PNG</strong> es para pantalla y
        documentos, en 2048, 512 y 128 px de ancho; el de 2048 aguanta
        impresión hasta unos 17 cm. Negro va sobre fondos claros y crema sobre
        oscuros, los dos con fondo transparente.
      </p>
      <div class="descargas">
        {
          descargas.map((d) => (
            <article class="descarga">
              <div class={`descarga-lienzo lienzo-${d.variante}`}>
                <Marca variante={d.variante} />
              </div>
              <div class="descarga-info">
                <h4 class="descarga-nombre">{d.nombre}</h4>
                <p class="descarga-uso">{d.uso}</p>
                {d.versiones.map((v) => (
                  <div class="descarga-version">
                    <span class={`descarga-tinta tinta-${v.tinta === "Crema" ? "crema" : v.tinta === "Negro" ? "negro" : "mostaza"}`}>
                      {v.tinta}
                    </span>
                    <div class="descarga-botones">
                      <a class="btn btn--sm" href={`/marca/${v.archivo}.svg`} download>
                        SVG
                      </a>
                      {anchosPng.map((ancho) => (
                        <a class="btn btn--outline btn--sm" href={`/marca/${v.archivo}-${ancho}.png`} download>
                          {ancho}
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ================= COLOR ================= -->
  <section class="alterna">
    <div class="wrap">
      <p class="eyebrow">02 · Color</p>
      <h2>Pigmentos</h2>
      <p class="lead">
        Seis valores crudos. Los componentes nunca los usan directo: usan roles.
      </p>

      <ul class="pigmentos">
        {
          pigmentos.map((p) => (
            <li class="pigmento">
              <span class="muestra" style={`background:${p.hex}`} />
              <div>
                <code>{p.nombre}</code>
                <span class="hex">{p.hex}</span>
                <span class="rol">{p.rol}</span>
              </div>
            </li>
          ))
        }
      </ul>

      <h3 class="sub">Roles por superficie</h3>
      <p>
        Esta es la pieza que faltaba. Antes, cada sección oscura tenía que
        repintar sus botones a mano. Ahora basta con
        <code>data-surface="ink"</code> y todo se invierte solo.
      </p>
      <div class="tabla-scroll">
        <table>
          <thead>
            <tr><th>Rol</th><th>Superficie clara</th><th>data-surface="ink"</th></tr>
          </thead>
          <tbody>
            {
              roles.map((r) => (
                <tr>
                  <td><code>{r.rol}</code></td>
                  <td>{r.claro}</td>
                  <td>{r.oscuro}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="nota">
        Terracota sobre tinta no alcanza contraste legible, por eso en oscuro el
        rol de acento tipográfico lo toma mostaza. Es la única sustitución del
        sistema y está resuelta en un solo lugar.
      </p>
    </div>
  </section>

  <!-- ================= IMPRESIÓN ================= -->
  <section id="impresion">
    <div class="wrap">
      <p class="eyebrow">03 · Impresión</p>
      <h2>En papel</h2>
      <p class="lead">
        Lo que hay que saber antes de mandar un sticker o un fanzine a la
        imprenta. La pantalla y el papel no mezclan color igual: aquí está la
        traducción.
      </p>

      <h3 class="sub">Tintas</h3>
      <div class="tabla-scroll">
        <table class="tabla-tintas">
          <thead>
            <tr>
              <th>Color</th>
              <th>CMYK estucado</th>
              <th>CMYK bond</th>
              <th>Pantone</th>
              <th>Cuándo</th>
            </tr>
          </thead>
          <tbody>
            {
              tintasImpresion.map((t) => (
                <tr>
                  <td>
                    <span class="tinta-nombre">
                      <span class="muestra-sm" style={`background:${t.hex}`} />
                      {t.color}
                    </span>
                  </td>
                  <td>{t.estucado}</td>
                  <td>{t.bond}</td>
                  <td>{t.pantone}</td>
                  <td>{t.uso}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="nota">
        <strong>Estucado</strong> es papel brillante o satinado y vinilo de
        sticker (perfil FOGRA39). <strong>Bond</strong> es papel sin brillo,
        el de fotocopia y fanzine (FOGRA29). Los valores salen de convertir los
        colores de pantalla con esos perfiles: son el punto de partida, y manda
        la prueba de color de la imprenta. Los Pantone son los más cercanos y
        hay que confirmarlos en una guía física antes de pedir tinta directa.
      </p>
      <p class="nota">
        <strong>Tinta honda y crema honda no existen en papel.</strong> Impresas,
        no se distinguen de tinta y crema: en bond las dos tintas oscuras dan
        exactamente el mismo CMYK.
      </p>

      <h3 class="sub">Tamaño mínimo</h3>
      <div class="minimos">
        {
          minimos.map((m) => (
            <figure class="minimo">
              <div class={`lienzo lienzo-bajo min-${m.variante}`}>
                <Marca variante={m.variante} />
              </div>
              <figcaption>
                <strong>{m.variante} · {m.medida}</strong>
                <span>{m.por}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="nota">
        Las marcas de arriba están dibujadas a su tamaño mínimo; en pantalla la
        medida es aproximada. Por debajo del mínimo del sello, usa el bloque.
      </p>

      <h3 class="sub">Zona de respeto</h3>
      <div class="respeto-fila">
        <div class="respeto">
          <div class="respeto-marca"><Marca variante="sello" /></div>
        </div>
        <p>
          Alrededor del sello queda libre <strong>un cuarto de su diámetro</strong>:
          ni texto, ni borde de corte, ni otra imagen. En el bloque y la fila, el
          espacio libre es <strong>el alto de una letra</strong>. Es lo que
          separa un sello de una mancha.
        </p>
      </div>

      <h3 class="sub">Sticker y fanzine</h3>
      <div class="formatos">
        <div class="caja">
          <span class="badge">Sticker</span>
          <dl class="specs">
            <dt>Troquel</dt><dd>Circular para el sello, 5 cm recomendado.</dd>
            <dt>Sangrado</dt><dd>2 mm por fuera del corte.</dd>
            <dt>Zona segura</dt><dd>3 mm por dentro del corte. La marca no la toca.</dd>
            <dt>Color</dt><dd>Tinta sobre mostaza, como el avatar. O tinta sobre vinilo blanco o crema.</dd>
          </dl>
        </div>
        <div class="caja">
          <span class="badge">Fanzine</span>
          <dl class="specs">
            <dt>A una tinta</dt><dd>Fotocopia o risografía: todo en tinta, sobre papel crema.</dd>
            <dt>A dos tintas</dt><dd>Tinta y mostaza. La terracota solo si hay tercera tinta.</dd>
            <dt>Sangrado</dt><dd>3 mm en cada borde que llegue al filo.</dd>
            <dt>Archivo</dt><dd>PDF con las fuentes incrustadas o pasadas a curvas.</dd>
          </dl>
        </div>
      </div>
      <p class="nota">
        Ojo con el frasco a una tinta: sus burbujas van al 60% de opacidad, y en
        fotocopia o risografía eso se vuelve trama de puntos. Para esas
        impresiones, las burbujas van sólidas.
      </p>

      <h3 class="sub">Errores que hay que evitar</h3>
      <div class="errores">
        <figure class="error">
          <div class="lienzo lienzo-bajo"><span class="err-estirada"><Marca variante="sello" /></span></div>
          <figcaption><strong>No estirar</strong><span>El sello es un círculo. Se escala completo o no se escala.</span></figcaption>
        </figure>
        <figure class="error">
          <div class="lienzo lienzo-bajo"><span class="err-anton">LSDF</span></div>
          <figcaption><strong>No recomponer en Anton</strong><span>Las letras están dibujadas a mano. La tipografía se parece, pero no es la marca.</span></figcaption>
        </figure>
        <figure class="error">
          <div class="lienzo lienzo-bajo"><span class="err-blur"><Marca variante="bloque" /></span></div>
          <figcaption><strong>No difuminar la sombra</strong><span>La sombra de la marca es dura y mostaza. Nunca con desenfoque.</span></figcaption>
        </figure>
        <figure class="error">
          <div class="lienzo lienzo-bajo lienzo-tinta"><span class="err-terracota"><Marca variante="bloque" /></span></div>
          <figcaption><strong>No terracota sobre tinta</strong><span>No alcanza contraste. Sobre tinta, el acento es mostaza.</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ================= CONVOCATORIAS ================= -->
  <section id="convocatorias" class="alterna">
    <div class="wrap">
      <p class="eyebrow">04 · Convocatorias</p>
